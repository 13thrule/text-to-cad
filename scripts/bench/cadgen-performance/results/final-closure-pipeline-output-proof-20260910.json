  "helperSource": "from pathlib import Path\nimport json\nimport statistics\n\nROOT = Path('/Users/jakefitzgerald/.codex/worktrees/3c6b/text-to-cad/scripts/bench/cadgen-performance/results')\nSUFFIX = 'closure-final-20260910'\nPAIRS = {\n    'mono': ('mono-after-unseen-cache-final-20260910.json', f'mono-after-unseen-{SUFFIX}.json', 'mono-before-unseen-final-20260910.json'),\n    'imported': ('imported-after-unseen-cache-final-20260910.json', f'imported-after-unseen-{SUFFIX}.json', 'imported-before-unseen-final-20260910.json'),\n    'split': ('planetary-split-after-cache-final-20260910.json', f'planetary-split-after-{SUFFIX}.json', 'planetary-split-before-novel-final-20260910.json'),\n}\n\n\ndef output_sha(row):\n    if row.get('actualRootStepSha256'):\n        return row['actualRootStepSha256']\n    values = list(row['actualOutputSha256'].values())\n    assert len(values) == 1, values\n    return values[0]\n\n\ndef median_rows(report, kind, novel):\n    return [row for row in report['runs'] if row['measured'] and row['variantKind'] == kind and row['novelEdit'] == novel]\n\n\ndef main():\n    reports = {}\n    proof = {'qualification': 'Current runtime actual emitted STEP hashes are compared with the prior validated current runtime, by call ordinal and exact run label. Baseline7aa emitted different STEP bytes; its geometric-equivalence qualification remains separate.', 'workloads': {}, 'summary': []}\n    for workload, (previous_name, current_name, before_name) in PAIRS.items():\n        previous, current, before = [json.loads((ROOT / name).read_text(encoding='utf-8')) for name in (previous_name, current_name, before_name)]\n        assert current['runtimeUnchangedDuringStudy'] and current['sourceRestored'] and current['inputClosureUnchangedAfterRestoration']\n        old_rows, rows = [data['runs'] for data in (previous, current)]\n        assert [row['run'] for row in old_rows] == [row['run'] for row in rows] and len(rows) == 32\n        checks = []\n        for ordinal, (previous_row, row) in enumerate(zip(old_rows, rows)):\n            name = row['run']\n            expected, actual = output_sha(previous_row), output_sha(row)\n            assert actual == expected, (workload, name, expected, actual)\n            assert row['exit'] == 0\n            checks.append({'ordinal': ordinal, 'run': name, 'expectedSha256': expected, 'actualSha256': actual, 'passed': True})\n        proof['workloads'][workload] = {'previousReport': previous_name, 'currentReport': current_name, 'baselineReport': before_name, 'sourceFingerprint': current['metadata']['sourceFingerprint'], 'callCount': len(rows), 'uniqueOutputVariants': len({output_sha(row) for row in rows}), 'actualOutputChecks': checks}\n        reports[workload] = current\n        for kind, novel in [('unchanged', False), ('geometry', False), ('placement', False), ('geometry', True), ('placement', True)]:\n            group = 'novelSummary' if novel else 'summary'\n            old_ms, now_ms, before_ms = [data[group][kind]['medianMs'] for data in (previous, current, before)]\n            selected = median_rows(current, kind, novel)\n            preview = [row['firstPreviewMs'] for row in selected if row['firstPreviewMs'] is not None]\n            proof['summary'].append({'workload': workload, 'kind': kind, 'novel': novel, 'beforeMs': before_ms, 'previousCurrentMs': old_ms, 'finalCurrentMs': now_ms, 'changeSincePreviousCurrentPercent': (now_ms/old_ms-1)*100, 'changeSinceBaselinePercent': (now_ms/before_ms-1)*100, 'finalPreviewMedianMs': statistics.median(preview) if preview else None})\n    fingerprints = {data['metadata']['sourceFingerprint'] for data in reports.values()}\n    assert len(fingerprints) == 1, fingerprints\n    mono = [(row['run'], output_sha(row)) for row in reports['mono']['runs']]\n    split = [(row['run'], output_sha(row)) for row in reports['split']['runs']]\n    assert mono == split\n    proof['finalMonoAndSplitEveryActualOutputIdentical'] = True\n    proof['unchangedSourceFingerprint'] = next(iter(fingerprints))\n    proof['complete'] = True\n    target = ROOT / 'final-closure-pipeline-output-proof-20260910.json'\n    assert not target.exists()\n    target.write_text(json.dumps(proof, indent=2, sort_keys=True) + '\\n', encoding='utf-8')\n    print(json.dumps({'proof': str(target), 'summary': proof['summary'], 'sourceFingerprint': proof['unchangedSourceFingerprint']}, indent=2))\n\n\nif __name__ == '__main__':\n    main()\n",
