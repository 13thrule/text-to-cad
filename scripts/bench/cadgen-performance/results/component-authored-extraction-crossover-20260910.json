    "probeSource": "from __future__ import annotations\n\nimport hashlib\nimport json\nimport multiprocessing\nimport os\nfrom pathlib import Path\nimport statistics\nimport time\nfrom concurrent.futures import ProcessPoolExecutor\n\n\ndef main():\n    root = Path('/Users/jakefitzgerald/.codex/worktrees/3c6b/text-to-cad')\n    study = json.loads((root / 'scripts/bench/cadgen-performance/results/warm-after-small-batch-20260910.json').read_text())\n    os.environ['CADGEN_CACHE_DIR'] = study['store']\n    import build123d\n    from cadgen._internal.component_package import _build_component_surf_worker, _component_build_worker_count\n    from cadgen.store.objects import read_object\n    from cadgen.store.trees import flatten\n    descriptor = flatten(study['runs'][0]['tree'])\n    blobs = {cid: read_object(entry['brep']) for cid, entry in descriptor['components'].items()}\n    output = root / 'models/tmp/component-authored-extraction-ab-uncontended'\n    workers = _component_build_worker_count(len(blobs), payload_bytes=sum(map(len, blobs.values())))\n    report = {'payloadBytes': sum(map(len, blobs.values())), 'components': len(blobs),\n              'tree': study['runs'][0]['tree'], 'inputHashes': {cid: hashlib.sha256(blob).hexdigest() for cid, blob in blobs.items()},\n              'rows': []}\n    expected = None\n    for sample in range(2):\n        for mode in (('serial', 'spawn') if sample == 0 else ('spawn', 'serial')):\n            folder = output / f'{sample}-{mode}'\n            folder.mkdir(parents=True, exist_ok=True)\n            payloads = [(blob, cid, str(folder / f'{cid}.surf'), None) for cid, blob in blobs.items()]\n            started = time.perf_counter()\n            if mode == 'spawn':\n                with ProcessPoolExecutor(max_workers=workers, mp_context=multiprocessing.get_context('spawn')) as pool:\n                    results = list(pool.map(_build_component_surf_worker, payloads))\n            else:\n                results = [_build_component_surf_worker(payload) for payload in payloads]\n            elapsed = (time.perf_counter() - started) * 1000\n            assert all(error is None for cid, error in results), results\n            hashes = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(folder.iterdir())\n                      if p.suffix in {'.surf', '.brep'}}\n            if expected is None:\n                expected = hashes\n            assert hashes == expected\n            row = {'mode': mode, 'sample': sample, 'workers': workers if mode == 'spawn' else 1,\n                   'milliseconds': elapsed, 'outputHashes': hashes}\n            report['rows'].append(row)\n            print({k: v for k, v in row.items() if k != 'outputHashes'}, flush=True)\n    report['summary'] = {mode: statistics.median(row['milliseconds'] for row in report['rows'] if row['mode'] == mode)\n                         for mode in ['serial', 'spawn']}\n    report['allOutputBytesEqual'] = True\n    Path('/private/tmp/cadgen-performance-20260910/component-authored-extraction-ab.json').write_text(json.dumps(report,indent=2)+'\\n')\n\n\nif __name__ == '__main__':\n    main()\n",
