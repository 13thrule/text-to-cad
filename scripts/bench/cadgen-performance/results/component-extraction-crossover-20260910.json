  "executedHarnessSource": "from __future__ import annotations\n\nimport hashlib\nimport json\nimport multiprocessing\nimport os\nfrom pathlib import Path\nimport statistics\nimport time\nfrom concurrent.futures import ProcessPoolExecutor\n\n\ndef main():\n    import build123d\n    from cadgen._internal.component_package import _build_component_surf_worker, _component_build_worker_count\n\n    root = Path('/Users/jakefitzgerald/.codex/worktrees/3c6b/text-to-cad')\n    output = root / 'models/tmp/component-extraction-ab'\n    sets = {}\n    for name, path in [('nine', root / 'models/tmp/perf-audit/view'),\n                       ('curved', root / 'models/tmp/mesh-quality/corpus')]:\n        descriptor = json.loads((path / 'assembly.json').read_text())\n        sets[name] = [(path / 'components' / f'{cid}.brep').read_bytes() for cid in descriptor['components']]\n    cases = [('nine', sets['nine']), ('nine-and-curved', sets['nine'] + sets['curved']),\n             ('nine-twice', sets['nine'] * 2)]\n    report = {'python': os.sys.executable, 'rootKernelImported': True, 'rows': []}\n    for name, blobs in cases:\n        expected = None\n        workers = _component_build_worker_count(len(blobs))\n        for sample in range(2):\n            for mode in (('serial', 'spawn') if sample == 0 else ('spawn', 'serial')):\n                folder = output / name / f'{sample}-{mode}'\n                folder.mkdir(parents=True, exist_ok=True)\n                payloads = [(blob, f'{index:016x}', str(folder / f'{index:016x}.surf'), None)\n                            for index, blob in enumerate(blobs)]\n                started = time.perf_counter()\n                if mode == 'spawn':\n                    with ProcessPoolExecutor(max_workers=workers, mp_context=multiprocessing.get_context('spawn')) as pool:\n                        results = list(pool.map(_build_component_surf_worker, payloads))\n                else:\n                    results = [_build_component_surf_worker(payload) for payload in payloads]\n                elapsed = (time.perf_counter() - started) * 1000\n                assert all(error is None for cid, error in results), results\n                hashes = {path.name: hashlib.sha256(path.read_bytes()).hexdigest()\n                          for path in sorted(folder.iterdir()) if path.suffix in {'.surf', '.brep'}}\n                assert len(hashes) == 2 * len(blobs)\n                if expected is None:\n                    expected = hashes\n                assert hashes == expected\n                row = {'case': name, 'count': len(blobs), 'payloadBytes': sum(map(len, blobs)),\n                       'mode': mode, 'workers': workers if mode == 'spawn' else 1,\n                       'sample': sample, 'milliseconds': elapsed, 'outputHashes': hashes}\n                report['rows'].append(row)\n                print(json.dumps({key: value for key, value in row.items() if key != 'outputHashes'}), flush=True)\n    report['summary'] = {name: {mode: statistics.median(row['milliseconds'] for row in report['rows']\n                                                     if row['case'] == name and row['mode'] == mode)\n                                for mode in ['serial', 'spawn']} for name, _ in cases}\n    report['allOutputBytesEqual'] = True\n    Path('/private/tmp/cadgen-performance-20260910/component-extraction-ab.json').write_text(json.dumps(report,indent=2)+'\\n')\n\n\nif __name__ == '__main__':\n    main()\n",
